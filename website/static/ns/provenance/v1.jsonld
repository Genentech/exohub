{
  "@context": {
    "prov": "http://www.w3.org/ns/prov#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "exo": "https://genentech.github.io/exohub/ns/provenance#",

    "Entity": "prov:Entity",
    "Collection": "prov:Collection",
    "Activity": "prov:Activity",
    "Agent": "prov:Agent",
    "Person": "prov:Person",
    "SoftwareAgent": "prov:SoftwareAgent",
    "Organization": "prov:Organization",

    "used": { "@id": "prov:used", "@type": "@id" },
    "wasGeneratedBy": { "@id": "prov:wasGeneratedBy", "@type": "@id" },
    "wasDerivedFrom": { "@id": "prov:wasDerivedFrom", "@type": "@id" },
    "wasRevisionOf": { "@id": "prov:wasRevisionOf", "@type": "@id" },
    "wasAssociatedWith": { "@id": "prov:wasAssociatedWith", "@type": "@id" },
    "wasAttributedTo": { "@id": "prov:wasAttributedTo", "@type": "@id" },
    "actedOnBehalfOf": { "@id": "prov:actedOnBehalfOf", "@type": "@id" },
    "hadPlan": { "@id": "prov:hadPlan", "@type": "@id" },
    "hadMember": { "@id": "prov:hadMember", "@type": "@id" },
    "hadPrimarySource": { "@id": "prov:hadPrimarySource", "@type": "@id" },
    "qualifiedUsage": { "@id": "prov:qualifiedUsage", "@type": "@id" },
    "qualifiedGeneration": { "@id": "prov:qualifiedGeneration", "@type": "@id" },
    "entity": { "@id": "prov:entity", "@type": "@id" },
    "activity": { "@id": "prov:activity", "@type": "@id" },

    "Usage": "prov:Usage",
    "Generation": "prov:Generation",
    "hadRole": "prov:hadRole",
    "value": "prov:value",

    "startedAtTime": { "@id": "prov:startedAtTime", "@type": "xsd:dateTime" },
    "endedAtTime": { "@id": "prov:endedAtTime", "@type": "xsd:dateTime" },
    "generatedAtTime": { "@id": "prov:generatedAtTime", "@type": "xsd:dateTime" },

    "label": "rdfs:label",

    "exo:path": "exo:path",
    "exo:repository": "exo:repository",
    "exo:commit": "exo:commit",
    "exo:assertion": "exo:assertion",
    "exo:assertedBy": { "@id": "exo:assertedBy", "@type": "@id" },
    "exo:evidence": "exo:evidence",
    "exo:supersedes": { "@id": "exo:supersedes", "@type": "@id" },
    "exo:model": "exo:model",
    "exo:version": "exo:version",
    "exo:fromRecord": { "@id": "exo:fromRecord", "@type": "@id" },
    "exo:records": { "@id": "exo:records", "@container": "@set" },
    "exo:checksum": "exo:checksum",
    "exo:minVersion": "exo:minVersion"
  }
}
