# .oss-allow — shared allowlist for the exo-cli OSS leak-guard
#
# Consumed by:
#   - scripts/leak-scan.sh  (denylist grep pass)
#   - .gitleaks.toml        ([allowlist] section — paths and regexes)
#   - .pre-commit-config.yaml (via leak-scan.sh wrapper hook)
#   - scripts/oss-export.sh (Step 5 leak-scan on dist/oss/)
#
# PURPOSE: this allowlist covers content that is LEGITIMATELY PRESENT in the
# public/exported tree and triggers a denylist false-positive.  Do NOT add
# entries just because "the export step removes/rewrites that file" — those
# files should not be in the exported tree at all, so they must not be
# pre-exempted here.
#
# Format (for scripts/leak-scan.sh):
#   file:<path>      — exempt an entire file from denylist grep
#   pattern:<regex>  — exempt every line matching this regex (use sparingly)
#
# Add entries here (with a comment explaining why) rather than weakening the
# denylist itself.

# ---------------------------------------------------------------------------
# The allowlist/config files self-reference denylist patterns by design.
# ---------------------------------------------------------------------------
file:.gitleaks.toml
file:.oss-allow

# ---------------------------------------------------------------------------
# Internal-only scripts — NOT shipped in the OSS export (scripts/ is removed
# from dist/oss/ entirely in Step 3 of oss-export.sh). Listed here so the
# internal-tree leak-scan (run against the working tree, not dist/oss/) does
# not flag them as leaks.
# ---------------------------------------------------------------------------
file:scripts/leak-scan.sh
file:scripts/test-leak-guard.sh
file:scripts/oss-export.sh
file:scripts/oss-sync.sh
file:scripts/verify-oss.sh
file:scripts/denylist-patterns.sh

# ---------------------------------------------------------------------------
# go/exo/safe/validate.go
# PEM-header literals ("-----BEGIN RSA PRIVATE KEY-----", etc.) are used to
# DETECT accidental key commits — they are not real keys.
# ---------------------------------------------------------------------------
file:go/exo/safe/validate.go

# ---------------------------------------------------------------------------
# go/git-annex-remote-artifactdb-export/main_test.go
# Uses "charon.example.com" as a test fixture hostname — not a real Roche host.
# ---------------------------------------------------------------------------
file:go/git-annex-remote-artifactdb-export/main_test.go

# ---------------------------------------------------------------------------
# go/exo-credential-helper/main_basecreds_test.go
# Contains unsigned JWT test tokens (//go:build !janus test file).
# go/exo/commands/doctor/doctor_test.go
# Contains the canonical jwt.io example JWT (SflKxwRJSMeKKF2QT4fwpMeJf36P)
# and alg:none tokens used for testing JWT parsing.
# go/exo/commands/init/grants_test.go
# Contains base64url-encoded JWT header/payload fixtures for testing.
# Gitleaks default rules flag JWT-structured strings; these are test fixtures
# with no real credentials.
# ---------------------------------------------------------------------------
file:go/exo-credential-helper/main_basecreds_test.go
file:go/exo-credential-helper/main_test.go
file:go/exo-credential-helper/main_exohubapi_test.go
file:go/exo/commands/doctor/doctor_test.go
file:go/exo/commands/init/grants_test.go
file:go/exo/internal/credhelper/credhelper_exohubapi_test.go
file:go/git-annex-remote-s5cmd/main_test.go
file:go/exo/commands/serve/static/xterm/xterm.js

# ---------------------------------------------------------------------------
# Regex allowlist — safe patterns that override false positives
# (mirrored into .gitleaks.toml [allowlist] regexes)
# ---------------------------------------------------------------------------

# PEM-header literals — detection strings, not actual keys.
pattern:-----BEGIN (OPENSSH |RSA |EC |DSA |ENCRYPTED )?PRIVATE KEY-----

# example.com is an IANA-reserved documentation domain; never a real host.
pattern:example\.com


# Author email addresses in git log output — commit metadata, not source.
pattern:^Author:.*@gene\.com
pattern:^author.*@gene\.com
